{
  "mcpServers": {
    "mioption": {
      "type": "stdio",
      "command": "${workspaceFolder}/runtime/.venv/bin/python",
      "args": ["-m", "mioption_runtime.agent.stdio_mcp"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/runtime",
        "MIOPTION_FUTU_MOCK": "1",
        "MIOPTION_VAULT": "${workspaceFolder}/knowledge"
      }
    }
  }
}
