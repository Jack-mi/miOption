{
  "version": 1,
  "actor": "apify/website-content-crawler",
  "content_scope": {
    "include": "期权教育与策略内容；若页面主体是期权，也包括期货期权（options on futures）。",
    "exclude": "不涉及期权的纯期货教育、交易或产品内容。"
  },
  "knowledge_policy": {
    "minimum_text_chars": 1200,
    "eligible_content_kinds": [
      "article",
      "reference",
      "strategy",
      "glossary",
      "text_lesson"
    ],
    "candidate_required_fields": [
      "knowledge_eligible",
      "knowledge_type",
      "content_kind",
      "video",
      "expected_fields"
    ],
    "excluded_url_fragments": [
      "/videolibrary/",
      "/video/",
      "/webinar/",
      "/podcast/",
      "/playlist/",
      "/watch/"
    ],
    "excluded_content_markers": [
      "video lessons",
      "start course",
      "learning portal",
      "explore more courses",
      "course overview"
    ]
  },
  "crawl_policy": {
    "sample_max_pages": 4,
    "max_crawl_pages": 12,
    "max_crawl_depth": 0,
    "crawler_type": "playwright:adaptive",
    "save_markdown": true,
    "save_html": false,
    "respect_robots_txt": true,
    "max_concurrency": 1,
    "max_request_retries": 1,
    "max_session_rotations": 0,
    "run_timeout_secs": 300,
    "wait_timeout_secs": 330,
    "estimated_cost_per_page_usd": 0.03,
    "max_cost_usd": 1.0,
    "min_content_chars": 100,
    "manual_review_below_chars": 500,
    "proxy": {
      "useApifyProxy": true
    }
  },
  "sources": [
    {
      "id": "oic",
      "name": "The Options Industry Council",
      "allowed": true,
      "sample_url": "https://www.optionseducation.org/optionsoverview/options-basics",
      "include_prefixes": [
        "/optionsoverview/",
        "/strategies/",
        "/advancedconcepts/",
        "/referencelibrary/"
      ]
    },
    {
      "id": "cboe",
      "name": "Cboe Options Institute",
      "allowed": true,
      "sample_url": "https://www.cboe.com/optionsinstitute/courses/options101",
      "include_prefixes": [
        "/optionsinstitute/"
      ]
    },
    {
      "id": "optionalpha",
      "name": "Option Alpha",
      "allowed": true,
      "sample_url": "https://optionalpha.com/options-strategies",
      "include_prefixes": [
        "/education/",
        "/courses/",
        "/options-strategies",
        "/handbook"
      ]
    },
    {
      "id": "cme",
      "name": "CME Institute",
      "allowed": true,
      "sample_url": "https://www.cmegroup.com/education/courses/curriculum-all-about-options",
      "include_prefixes": [
        "/education/"
      ]
    },
    {
      "id": "wikipedia",
      "name": "Wikipedia",
      "allowed": true,
      "sample_url": "https://en.wikipedia.org/wiki/Margin_(finance)",
      "include_prefixes": [
        "/wiki/Margin_(finance)",
        "/wiki/Bid-ask_spread",
        "/wiki/Bid–ask_spread"
      ]
    },
    {
      "id": "investopedia",
      "name": "Investopedia",
      "allowed": false,
      "reason": "Terms and robots.txt prohibit automated scraping and AI dataset construction; retain links only, not crawled content."
    }
  ]
}
